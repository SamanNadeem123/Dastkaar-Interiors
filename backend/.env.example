# ---- Core ----
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/na_furniture_valley
# Optional: used only when running `pytest` (defaults to a separate local test DB if unset)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/na_furniture_valley_test

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If Cloudinary is not configured, images are stored locally under /static/uploads (dev fallback only)

# ---- Email (SMTP) ----
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@nafurniturevalley.com
ADMIN_EMAIL=admin@nafurniturevalley.com

# ---- Admin signup protection ----
ADMIN_SIGNUP_ENABLED=True
ADMIN_SIGNUP_KEY=change-this-secret

# ---- WhatsApp ----
WHATSAPP_NUMBER=923000000000

# ---- Payments ----
# Provider: "sandbox" (default, no real gateway needed) or "stripe"
PAYMENT_PROVIDER=sandbox
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- Store defaults ----
DEFAULT_DELIVERY_CHARGE=3000
CURRENCY=PKR
